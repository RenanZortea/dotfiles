# 1. First, ignore EVERYTHING in this directory
/*

# 2. Allow gitignore itself (so it gets versioned)
!/.gitignore
!/README.md
!/sync.sh
!/restore.sh
!/hooks
# --- Whitelist (Allow these folders) ---
# Remove trailing slashes to catch both folders and symlinks
!/alacritty
!/bottom
!/btop
!/dunst
!/fastfetch
!/systemd
!/restic
!/git
!/ghostty
!/gtk-3.0
!/gtk-4.0
!/hypr
!/kitty
!/matugen
!/ml4w
!/nvim
!/ohmyposh
!/opencode
!/rofi
!/swaync
!/tmux
!/waybar
!/wlogout
!/wallust

# Specific files
!/bashrc
!/zshrc
!/mimeapps.list
!/user-dirs.dirs

# tpm installs these; do not vendor them
/tmux/plugins/

# npm installs these for the opencode provider sdk; do not vendor them
/opencode/node_modules/
